{
  "name": "saspytest-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -e '.[dev]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.flake8",
        "ms-python.pylint"
      ]
    }
  }
}